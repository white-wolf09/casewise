# Frontend mode: false = call the Express/Vercel API, true = offline mock
VITE_USE_MOCK=false

# Port for local backend server
PORT=5000

# Secret for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Groq API Configuration for AI Features (Casewise Assist, Document Analysis)
# Sign up at https://console.groq.com to get your free API key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Atlas connection string (optional - falls back to memory store if empty)
# Free M0 cluster available at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/casewise?retryWrites=true&w=majority
